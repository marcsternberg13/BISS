<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BISS — Investor Pitch · Tell Your Truth</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --pink:#FF3DB5;--pink2:#FF65C3;--lime:#E9FF3A;--aqua:#19E4D0;--cyan:#50CDED;
  --violet:#7B2FF2;--lav:#A780ED;--coral:#FF5C7A;--tang:#FFB03A;--mint:#3DE6B0;
  --ink2:#0B0710;--surface:#211433;--line:rgba(255,255,255,.13);--text:#F3EEFA;--muted:#B3A6C9;
  --vapor:linear-gradient(168deg,#2C2688 0%,#5C1BAB 55%,#2b1150 100%);
  --f-disp:'Anton',sans-serif;--f-mark:'Fredoka',sans-serif;--f-mono:'Space Mono',monospace;--f-body:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--ink2);color:var(--text);font-family:var(--f-body);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 26px;position:relative;z-index:2}
.mono{font-family:var(--f-mono)}
::selection{background:var(--lime);color:#160A1C}
.mark{font-family:var(--f-mark);font-weight:700;position:relative;display:inline-block;color:var(--pink2);line-height:1}
.mark::before{content:attr(data-t);position:absolute;left:-2.5px;top:1.5px;color:var(--cyan);z-index:-1;opacity:.9}

/* ── BISO stamp (everywhere) ── */
.biso{font-family:var(--f-mono);font-weight:700;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--pink2)}

/* ── TOP BAR ── */
.topbar{position:sticky;top:0;z-index:60;background:rgba(11,7,16,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:66px;gap:18px}
.topbar .brand{display:flex;align-items:center;gap:10px}
.topbar .brand .mark{font-size:30px}
.topbar .kiss{width:26px;height:14px}
.tagchip{font-family:var(--f-mono);font-weight:700;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#160A1C;background:var(--lime);padding:5px 11px;border-radius:999px}
.links{display:flex;gap:24px}
.links a{font-family:var(--f-mono);font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);transition:color .15s}
.links a:hover{color:var(--lime)}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--f-mono);font-weight:700;font-size:13px;letter-spacing:.03em;text-transform:uppercase;padding:12px 20px;border-radius:9px;cursor:pointer;border:0;transition:transform .15s,box-shadow .15s}
.btn.lime{background:var(--lime);color:#181400;box-shadow:0 8px 26px rgba(233,255,58,.28)}
.btn.lime:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(233,255,58,.4)}
.hamb{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:0;padding:6px}
.hamb span{width:24px;height:2px;background:var(--text);display:block}

/* ── SECTIONS ── */
section{position:relative;padding:92px 0;overflow:hidden}
.band.dark{background:var(--ink2)}
.band.deep{background:linear-gradient(180deg,#160C24,#0B0710)}
.band.lime{background:var(--lime);color:#160A1C}
.band.magenta{background:var(--pink);color:#210419}
.band.violet{background:var(--violet);color:#fff}
.band.vapor{background:var(--vapor);color:#fff}
.floor{position:absolute;left:-10%;right:-10%;bottom:0;height:280px;pointer-events:none;opacity:.4;z-index:0;
  background-image:linear-gradient(rgba(80,205,237,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(167,128,237,.45) 1px,transparent 1px);
  background-size:52px 52px,52px 52px;transform:perspective(400px) rotateX(66deg);transform-origin:bottom;
  -webkit-mask-image:linear-gradient(to top,#000,transparent);mask-image:linear-gradient(to top,#000,transparent)}
.glow{position:absolute;border-radius:50%;filter:blur(90px);opacity:.4;pointer-events:none;z-index:0}

/* summary-first header */
.eyebrow{font-family:var(--f-mono);font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--aqua);display:flex;gap:11px;align-items:center;margin-bottom:16px;flex-wrap:wrap}
.eyebrow::before{content:"";width:26px;height:2px;background:currentColor}
.eyebrow .biso{color:inherit;opacity:.65}
.band.lime .eyebrow,.band.magenta .eyebrow{color:#160A1C;opacity:.85}
.summary{font-family:var(--f-body);font-weight:900;font-size:clamp(30px,4.7vw,52px);line-height:1.06;letter-spacing:-.015em;max-width:20ch}
.hook{font-family:var(--f-disp);text-transform:uppercase;font-size:clamp(18px,2.5vw,26px);color:var(--pink2);margin-top:12px;line-height:1.05}
.band.lime .hook,.band.magenta .hook,.band.violet .hook,.band.vapor .hook{color:currentColor}
.detail{font-size:16.5px;line-height:1.65;color:var(--muted);max-width:60ch}
.band.lime .detail,.band.magenta .detail{color:rgba(0,0,0,.72)}
.band.violet .detail,.band.vapor .detail{color:rgba(255,255,255,.86)}
.detail b{color:var(--text);font-weight:700}.band.lime .detail b,.band.magenta .detail b{color:#160A1C}
.detail+.detail{margin-top:14px}
.readmore{font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--aqua);margin:18px 0 2px;display:flex;gap:9px;align-items:center}
.readmore::before{content:"↓";}
.band.lime .readmore,.band.magenta .readmore{color:#160A1C}

/* two-col: summary/detail + real screen */
.split2{display:grid;grid-template-columns:1fr 340px;gap:48px;align-items:center}
.split2.rev{grid-template-columns:340px 1fr}

/* ── REAL DESIGNED SCREEN (scaled, scoped) ── */
.gswrap{width:300px;max-width:82vw;aspect-ratio:382/812;position:relative;margin:0 auto;filter:drop-shadow(0 30px 64px rgba(0,0,0,.5))}
.gs{position:absolute;top:0;left:0;width:382px;transform:scale(.785);transform-origin:top left;font-family:var(--f-body);line-height:1.55;color:#160A1C;
  --pink:#FF3DB5;--pinkink:#D60B7C;--lime:#E9FF3A;--aqua:#19E4D0;--cyan:#50CDED;--tang:#FFB03A;--lav:#B98CFF;--mint:#3DE6B0;--violet:#6B3FEF;--coralink:#E71D3C;--tealink:#0A8478;--ink:#160A1C;--muted:#6B6480;--line:#E7E2F0;--sub:rgba(22,10,28,.68)}
.gs .phone{width:382px;border-radius:40px;overflow:hidden;box-shadow:0 0 0 8px #0e0716,0 0 0 9px rgba(255,255,255,.08)}
.gs .scr{height:812px;display:flex;flex-direction:column;background:var(--neon);color:var(--ink);position:relative}
.gs .scr.cyan{--neon:#50CDED}.gs .scr.mag{--neon:#FF3DB5}.gs .scr.lime{--neon:#E9FF3A}.gs .scr.aqua{--neon:#19E4D0}.gs .scr.tang{--neon:#FFB03A}.gs .scr.lav{--neon:#B98CFF}.gs .scr.mint{--neon:#3DE6B0}.gs .scr.coral{--neon:#FF7A9C}
.gs .sb{display:flex;justify-content:space-between;align-items:center;padding:16px 24px 5px;font-family:var(--f-mono);font-size:12px;color:var(--ink);font-weight:700}
.gs .sb .tag{font-weight:400;letter-spacing:.12em;text-transform:uppercase;font-size:9px;color:var(--sub)}
.gs .top{display:flex;align-items:center;justify-content:space-between;padding:6px 20px 12px}
.gs .mk{font-family:var(--f-mark);font-weight:700;font-size:23px;color:var(--ink)}
.gs .body{flex:1;overflow:hidden;padding:2px 18px 96px;display:flex;flex-direction:column;gap:11px}
.gs .nav{position:absolute;left:16px;right:16px;bottom:18px;height:58px;background:#fff;border-radius:19px;box-shadow:0 10px 24px rgba(22,10,28,.2);display:flex;align-items:center;justify-content:space-around}
.gs .nav .t{display:flex;flex-direction:column;align-items:center;gap:3px;font-family:var(--f-mono);font-size:7.5px;color:var(--muted)}
.gs .nav .t svg{width:18px;height:18px;stroke:var(--muted);fill:none;stroke-width:1.8}
.gs .nav .t.on{color:var(--pinkink)}.gs .nav .t.on svg{stroke:var(--pink)}
.gs .nav .fab{width:46px;height:46px;border-radius:50%;background:var(--pinkink);display:grid;place-items:center;margin-top:-20px;box-shadow:0 10px 20px rgba(214,11,124,.45)}
.gs .nav .fab svg{width:22px;height:22px;stroke:#fff;stroke-width:2.5;fill:none}
.gs .h-disp{font-family:var(--f-disp);text-transform:uppercase;line-height:.92;color:var(--ink)}
.gs .lbl{font-family:var(--f-mono);font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--sub)}
.gs .t-sm{font-size:12.5px}.gs .t-mut{font-size:11.5px;color:var(--muted)}.gs .t-b{font-weight:700;font-size:13.5px}
.gs .htag{font-family:var(--f-mono);font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--tealink)}.gs .htag.p{color:var(--pinkink)}.gs .htag.m{color:var(--muted)}
.gs .between{display:flex;justify-content:space-between;align-items:center}.gs .row{display:flex;gap:8px}.gs .col{display:flex;flex-direction:column;gap:8px}
.gs .card{background:#fff;border-radius:14px;padding:12px;box-shadow:0 5px 14px rgba(22,10,28,.1)}
.gs .card.flat{box-shadow:none;border:1px solid var(--line)}
.gs .score{border-radius:12px;display:grid;place-items:center;font-family:var(--f-disp);background:var(--aqua);color:#04302c;line-height:1}
.gs .score .n{font-size:22px}.gs .score .u{font-family:var(--f-mono);font-size:6px;letter-spacing:.08em;opacity:.75;margin-top:1px}
.gs .score.neg{background:var(--coralink);color:#fff}.gs .score.neu{background:var(--violet);color:#fff}
.gs .score.sm{width:40px;height:40px;border-radius:10px}.gs .score.sm .n{font-size:16px}.gs .score.sm .u{display:none}
.gs .score.big{width:104px;height:104px;border-radius:24px}.gs .score.big .n{font-size:44px}.gs .score.big .u{font-size:8px}
.gs .pill{display:inline-flex;align-items:center;gap:5px;font-family:var(--f-mono);font-size:10px;letter-spacing:.03em;border:1.4px solid var(--line);border-radius:999px;padding:5px 10px;color:var(--muted);background:#fff}
.gs .pill.on{border-color:var(--tealink);color:var(--tealink);background:rgba(25,228,208,.12)}
.gs .pill.p{border-color:var(--pink);color:var(--pinkink);background:rgba(255,61,181,.1)}
.gs .pill.solid{background:var(--pinkink);border-color:var(--pinkink);color:#fff}
.gs .chips{display:flex;gap:6px;flex-wrap:wrap}
.gs .bar{height:8px;border-radius:4px;background:rgba(22,10,28,.12)}.gs .bar .fl{height:100%;border-radius:4px;background:var(--tealink)}.gs .bar .fl.p{background:var(--pinkink)}
.gs .redact{display:inline-block;height:1em;vertical-align:-2px;background:var(--pinkink);border-radius:3px}
.gs .cta{display:block;text-align:center;font-family:var(--f-mono);font-weight:700;letter-spacing:.05em;font-size:13px;border-radius:13px;padding:13px}
.gs .cta.pink{background:var(--pinkink);color:#fff}.gs .cta.ink{background:var(--ink);color:#fff}
.gs .av{border-radius:50%;flex:none;background:linear-gradient(135deg,var(--violet),var(--aqua));box-shadow:0 0 0 2px #fff}
.gs .av.p{background:linear-gradient(135deg,var(--pinkink),var(--tang))}.gs .av.q{background:linear-gradient(135deg,var(--aqua),var(--tealink))}
.gs .bub{max-width:88%;padding:10px 13px;border-radius:16px;font-size:12.5px;line-height:1.5}
.gs .bub.ai{align-self:flex-start;background:#fff;color:var(--ink);border-bottom-left-radius:5px}
.gs .bub.me{align-self:flex-end;background:var(--ink);color:#fff;border-bottom-right-radius:5px}
.gs .detect{align-self:flex-start;display:inline-flex;gap:6px;align-items:center;font-family:var(--f-mono);font-size:10px;color:var(--ink);background:#fff;border-radius:999px;padding:6px 11px}
.gs .faceZone{display:flex;flex-direction:column;align-items:center;gap:8px;padding:4px 0}
.gs .inbar{display:flex;align-items:center;gap:9px;margin-top:auto;padding:9px 12px;background:#fff;border-radius:999px}
.gs .inbar span{font-size:12px;color:var(--muted);flex:1}.gs .inbar .s{width:30px;height:30px;border-radius:50%;background:var(--pinkink);display:grid;place-items:center}.gs .inbar .s svg{width:15px;height:15px;stroke:#fff;stroke-width:2.4;fill:none}

/* ── HERO ── */
.hero{background:radial-gradient(120% 90% at 50% 0%,#3a1866 0%,#1c0f36 46%,#0B0710 100%);padding:56px 0 84px;text-align:center}
.tyt{font-family:var(--f-disp);text-transform:uppercase;font-size:clamp(52px,10vw,120px);line-height:.9;letter-spacing:.01em;color:#fff;text-shadow:-2px 0 rgba(80,205,237,.5),2px 0 rgba(255,61,181,.5)}
.hero .bisohero{font-family:var(--f-mono);font-weight:700;letter-spacing:.4em;text-transform:uppercase;color:var(--lime);font-size:clamp(12px,1.8vw,16px);margin-top:14px}
.hero-grid{display:grid;grid-template-columns:1fr 330px;gap:44px;align-items:center;text-align:left;margin-top:52px}
.hero h1{font-family:var(--f-body);font-weight:900;font-size:clamp(28px,3.6vw,40px);line-height:1.08;letter-spacing:-.015em}
.hero .baby{font-family:var(--f-disp);text-transform:uppercase;font-size:clamp(17px,2.1vw,23px);line-height:1.08;margin-top:18px;color:#fff}
.hero .baby .hl{color:var(--pink2)}
.hero .catch{font-family:var(--f-disp);text-transform:uppercase;color:var(--lime);font-size:clamp(16px,2vw,21px);margin-top:14px}
.capture{display:flex;gap:10px;margin-top:24px;max-width:460px;flex-wrap:wrap}
.capture input{flex:1;min-width:200px;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:9px;padding:13px 16px;color:#fff;font-family:var(--f-mono);font-size:13px}
.capture input::placeholder{color:#8a7ea3}
.micro{font-family:var(--f-mono);font-size:11.5px;color:#8f83a8;margin-top:13px;letter-spacing:.02em}

/* ── MARQUEE (BISO everywhere) ── */
.marquee{background:var(--lime);color:#160A1C;overflow:hidden;white-space:nowrap;padding:13px 0;border-top:2px solid #160A1C;border-bottom:2px solid #160A1C}
.marquee .track{display:inline-block;animation:scroll 26s linear infinite;font-family:var(--f-disp);text-transform:uppercase;font-size:23px;letter-spacing:.03em}
.marquee.pink{background:var(--pink);color:#210419}
.marquee.pink .track{animation-duration:30s}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── TILES (ten lines) ── */
.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:13px;margin-top:32px}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px;display:flex;gap:13px;align-items:flex-start;transition:transform .15s,border-color .15s}
.tile:hover{transform:translateY(-3px);border-color:var(--pink)}
.tile .em{font-size:23px;line-height:1;flex:none}
.tile h4{font-weight:800;font-size:15.5px;color:#fff;margin-bottom:2px}
.tile p{font-size:13px;color:var(--muted);line-height:1.45}

/* ── FEATURE CARDS ── */
.fcards{display:grid;gap:16px;margin-top:32px}
.g3{grid-template-columns:repeat(3,1fr)}.g2{grid-template-columns:1fr 1fr}
.fcard{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:23px;position:relative;overflow:hidden;transition:transform .15s}
.fcard:hover{transform:translateY(-4px)}
.fcard .rail{position:absolute;top:0;left:0;width:100%;height:4px}
.fcard .n{font-family:var(--f-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--pink2);font-weight:700;margin-bottom:10px}
.fcard h3{font-weight:800;font-size:19px;color:#fff;line-height:1.15;margin-bottom:8px}
.fcard p{font-size:14px;color:var(--muted);line-height:1.55}
.band.violet .fcard{background:rgba(0,0,0,.22);border-color:rgba(255,255,255,.22)}
.band.violet .fcard h3{color:#fff}.band.violet .fcard p{color:#fff;opacity:.88}

.compare{margin-top:26px;display:grid;gap:11px}
.cmp{display:grid;grid-template-columns:150px 1fr;gap:16px;padding:14px 18px;background:var(--surface);border:1px solid var(--line);border-radius:13px;align-items:baseline}
.cmp .name{font-weight:800;color:#fff;font-size:15px}
.cmp p{font-size:14px;color:var(--muted);line-height:1.5}
.cmp .plus{color:var(--aqua);font-weight:700}.cmp .minus{color:var(--coral);font-weight:700}

.duo{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:26px}
.duo .box{border-radius:18px;padding:24px;background:var(--surface)}
.duo .real{border:1px solid var(--lime)}.duo .alt{border:1px solid var(--pink)}
.duo .box .t{font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:9px}
.duo .real .t{color:var(--lime)}.duo .alt .t{color:var(--pink2)}
.duo .box h3{font-weight:800;font-size:20px;color:#fff;margin-bottom:8px}
.duo .box p{font-size:14px;color:var(--muted);line-height:1.55}

.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-top:30px}
.step{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px}
.band.violet .step{background:rgba(0,0,0,.22);border-color:rgba(255,255,255,.22)}
.step .no{font-family:var(--f-disp);font-size:30px;color:var(--lime);line-height:1}
.step h4{font-weight:800;font-size:15.5px;color:#fff;margin:9px 0 6px}
.step p{font-size:13px;color:#D9CEE9;line-height:1.5}

/* TYT divider band */
.tytband{background:var(--vapor);text-align:center;padding:60px 0}
.tytband .big{font-family:var(--f-disp);text-transform:uppercase;font-size:clamp(40px,8vw,96px);line-height:.9;color:#fff;text-shadow:-2px 0 rgba(80,205,237,.5),2px 0 rgba(255,61,181,.5)}
.tytband .biso{display:block;margin-top:14px;color:var(--lime);letter-spacing:.4em}

.promises{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin-top:30px}
.promise{background:rgba(0,0,0,.86);border-radius:16px;padding:20px 16px;text-align:center}
.promise .em{font-size:24px}.promise h4{color:#fff;font-weight:800;font-size:15px;margin:8px 0 4px}.promise p{color:#B3A6C9;font-size:12px;line-height:1.4}

.callout{margin-top:24px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--lime);border-radius:0 14px 14px 0;padding:20px 24px}
.callout .big{font-family:var(--f-disp);text-transform:uppercase;font-size:clamp(18px,2.3vw,25px);color:#fff;line-height:1.1}
.callout p{margin-top:8px;font-size:14.5px;color:var(--muted)}
.band.violet .callout{background:rgba(0,0,0,.24)}.band.violet .callout p{color:#E7DCF4}

.ctaband{text-align:center}.ctaband .capture{margin:24px auto 0;justify-content:center}
.perks{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:32px;text-align:left}
.perk{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:18px}
.perk .em{font-size:21px}.perk h4{color:#fff;font-weight:800;font-size:15px;margin:8px 0 4px}.perk p{color:rgba(255,255,255,.8);font-size:13px;line-height:1.45}

footer{background:#08040D;border-top:1px solid var(--line);padding:54px 0 38px}
.fgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:30px}
.fcol h5{font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--pink2);margin-bottom:13px}
.fcol a,.fcol p{display:block;color:var(--muted);font-size:13.5px;margin-bottom:8px;line-height:1.4}
.fcol a:hover{color:var(--lime)}
.fbrand .mark{font-size:36px}.fbrand .tl{font-family:var(--f-mono);font-size:12px;color:var(--muted);margin-top:8px}
.fbrand .bisofoot{font-family:var(--f-disp);text-transform:uppercase;font-size:26px;color:var(--lime);margin-top:12px}
.fbot{margin-top:38px;padding-top:20px;border-top:1px solid var(--line);display:flex;justify-content:space-between;font-family:var(--f-mono);font-size:11px;color:#6f6486;letter-spacing:.06em;flex-wrap:wrap;gap:10px}

.rv{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.rv.in{opacity:1;transform:none}

