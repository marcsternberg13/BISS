/* ===================== DECK · FIXED 16:9 LANDSCAPE ===================== */
html{scroll-behavior:smooth}
body{overflow-x:hidden;background:#050308}
.deck{scroll-snap-type:y mandatory}
.stage{height:100vh;display:flex;align-items:center;justify-content:center;
  scroll-snap-align:start;overflow:hidden;padding:12px}
.slide{position:relative;width:1280px;height:720px;flex:none;overflow:hidden;border-radius:8px;
  transform:scale(var(--s,1));transform-origin:center center;
  box-shadow:0 30px 80px rgba(0,0,0,.55)}
.slide .wrap{max-width:none;width:100%;height:100%;margin:0;padding:40px 58px;
  display:flex;flex-direction:column;justify-content:center}
.slide.top .wrap{justify-content:flex-start}
.slide.dark{background:var(--ink2)}
.slide.lime{background:var(--lime)}
.slide.pink{background:var(--pink)}
.slide.vapor{background:var(--vapor)}
.slide.lime .eyebrow,.slide.lime .eyebrow .biso{color:#160A1C}
.slide.dark::before{content:"";position:absolute;inset:0;z-index:-1;
  background:radial-gradient(60% 55% at 82% 18%,rgba(123,47,242,.22),transparent 60%),
             radial-gradient(50% 50% at 6% 94%,rgba(25,228,208,.13),transparent 60%)}
.slide.vapor::before{content:"";position:absolute;inset:0;z-index:-1;
  background:radial-gradient(70% 60% at 86% 12%,rgba(255,61,181,.24),transparent 62%),
             radial-gradient(55% 55% at 8% 96%,rgba(25,228,208,.15),transparent 60%)}
/* viewfinder */
.vf{position:absolute;inset:24px;pointer-events:none;z-index:3}
.vf span{position:absolute;width:20px;height:20px;border:2px solid var(--aqua);opacity:.55}
.vf span:nth-child(1){top:0;left:0;border-right:0;border-bottom:0}
.vf span:nth-child(2){top:0;right:0;border-left:0;border-bottom:0}
.vf span:nth-child(3){bottom:0;left:0;border-right:0;border-top:0}
.vf span:nth-child(4){bottom:0;right:0;border-left:0;border-top:0}
.slide.lime .vf span{border-color:#160A1C;opacity:.4}
.slide.pink .vf span,.slide.vapor .vf span{border-color:rgba(255,255,255,.5)}
/* headline system (fixed px for scaled canvas) */
.eyebrow{font-size:11px;letter-spacing:.2em;margin-bottom:9px}
.dh{font-family:var(--f-body);font-weight:900;font-size:36px;line-height:1.05;
  letter-spacing:-.022em;text-wrap:balance;margin:2px 0 9px;color:var(--text)}
.dh.sm{font-size:27px}
.dsub{font-size:15px;font-weight:600;color:var(--aqua);line-height:1.32;
  max-width:66ch;text-wrap:balance;margin-bottom:12px}
.slide.dark .dsub{color:var(--lav)}
.slide.lime .dh,.slide.lime .dsub{color:#160A1C}
.slide.vapor .dh{color:#fff}.slide.vapor .dsub{color:var(--lime)}
.slide.pink .dh{color:#fff}.slide.pink .dsub{color:#160A1C}
/* columns */
.cols{display:grid;grid-template-columns:1.02fr .98fr;gap:38px;align-items:center;flex:1;min-height:0}
.cols.wide{grid-template-columns:1.12fr .88fr}
.cols.rev>.copy{order:2}.cols.rev>.art{order:1}
.cols>.copy{min-width:0}
/* point lists */
.pts{display:flex;flex-direction:column;gap:7px;margin-top:2px}
.pt{display:grid;grid-template-columns:auto 1fr;gap:11px;align-items:start;font-size:12.8px;line-height:1.33}
.pt .m{width:8px;height:8px;margin-top:6px;background:var(--pink);flex:none;box-shadow:2px 2px 0 var(--cyan)}
.pt .x{font-family:var(--f-mono);font-weight:700;font-size:11px;color:var(--aqua);margin-top:2px;min-width:20px}
.pt div>b{color:var(--text);font-weight:800}
.pt div>span{color:var(--muted)}
.slide.lime .pt div>span{color:rgba(22,10,28,.72)}
.slide.lime .pt div>b{color:#160A1C}
.slide.lime .pt .m{background:#160A1C;box-shadow:2px 2px 0 var(--pink)}
/* callout quote */
.qt{font-family:var(--f-body);font-weight:800;font-size:15.5px;line-height:1.26;
  border-left:3px solid var(--lime);padding:2px 0 2px 15px;margin-top:10px;text-wrap:balance;color:#fff}
.slide.lime .qt{border-color:#160A1C;color:#160A1C}
.slide.vapor .qt{color:#fff;border-color:var(--lime)}
/* stat chips */
.chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:6px}
.chip{font-family:var(--f-mono);font-size:11px;letter-spacing:.05em;padding:7px 12px;
  border:1.4px solid var(--line);border-radius:999px;color:var(--text);background:rgba(255,255,255,.03)}
.chip b{color:var(--lime)}
/* tables */
.tbl{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:2px}
.tbl th{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--aqua);text-align:left;padding:8px 12px;border-bottom:1.5px solid var(--line);white-space:nowrap}
.tbl td{padding:9px 12px;border-bottom:1px solid var(--line);color:var(--muted);vertical-align:middle}
.tbl td b{color:var(--text)}
.tbl tr.hi td{background:rgba(255,61,181,.10)}
.tbl .big{font-family:var(--f-body);font-weight:900;font-size:14px;color:var(--lime)}
.tbl .tier{font-family:var(--f-body);font-weight:900;color:var(--text);font-size:13.5px}
/* mini cards */
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:4px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:4px}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:13px;margin-top:4px}
.card2{border:1px solid var(--line);border-radius:12px;padding:15px 16px;background:rgba(255,255,255,.025)}
.card2 .k{font-family:var(--f-mono);font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:var(--aqua);margin-bottom:6px}
.card2 h4{font-family:var(--f-body);font-weight:900;font-size:15.5px;margin:0 0 5px;color:var(--text)}
.card2 p{margin:0;color:var(--muted);font-size:12.5px;line-height:1.45}
.card2 .big{font-family:var(--f-body);font-weight:900;font-size:24px;color:var(--lime);line-height:1}
/* big stat cards (VP business) */
.statrow{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:6px 0 4px}
.stat{border:1px solid var(--line);border-top:3px solid var(--pink);border-radius:12px;padding:16px 16px;background:rgba(255,255,255,.025)}
.stat .n{font-family:var(--f-disp);font-size:38px;color:var(--lime);line-height:.95}
.stat .l{color:var(--muted);font-size:12px;line-height:1.35;margin-top:8px}
/* process steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:6px}
.slide .step{background:transparent;border:0;border-radius:0;border-top:2px solid var(--pink);padding:10px 0 0}
.step .n{font-family:var(--f-disp);font-size:24px;color:var(--pink);line-height:1}
.step b{display:block;color:var(--text);font-weight:800;margin:5px 0 3px;font-size:13.5px}
.step span{color:var(--muted);font-size:12px;line-height:1.4}
.slide.lime .step{border-color:#160A1C}.slide.lime .step .n{color:#160A1C}
.slide.lime .step b{color:#160A1C}.slide.lime .step span{color:rgba(22,10,28,.7)}
/* screens */
.pscreen{display:flex;justify-content:center;align-items:center;height:100%;zoom:.82}
.pscreen .gswrap{width:300px;max-width:100%}
.dscreen{zoom:.46;filter:drop-shadow(0 22px 48px rgba(0,0,0,.5));border-radius:14px}
@supports not (zoom:1){.dscreen{transform:scale(.46);transform-origin:top left}}
/* title */
.title-mark{font-family:var(--f-mark);font-weight:700;color:var(--pink2);position:relative;
  display:inline-block;font-size:120px;line-height:.9}
.title-mark::before{content:"biss";position:absolute;left:-4px;top:2px;color:var(--cyan);z-index:-1;opacity:.85}
.title-mark.sm{font-size:60px}
.title-row{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.title-row .kiss{width:56px;height:30px}
