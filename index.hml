<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BISS — Conversational Customer Intelligence Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --dark:#060E1C;--navy:#091525;--card:#0D1F38;--card2:#0F2442;--border:#1A3355;
  --teal:#00C4A7;--teal2:#00E5C5;--teal-dk:#007A68;--gold:#F0B429;--gold2:#FFD166;
  --white:#FFFFFF;--off:#C8D8EE;--muted:#647A96;--dim:#3A5070;
  --coral:#F97066;--purple:#818CF8;--blue:#60A5FA;--green:#10B981;--pink:#F0157A;
}
body{background:var(--dark);color:var(--off);font-family:'Inter',sans-serif;font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased}
.page{width:1100px;margin:0 auto;padding:60px 64px}

.masthead{display:grid;grid-template-columns:auto 1fr;gap:48px;align-items:center;margin-bottom:48px;padding-bottom:40px;border-bottom:1px solid var(--border)}
.logo{font-family:'Syne',sans-serif;font-size:80px;font-weight:800;color:var(--teal);letter-spacing:-3px;line-height:1}
.logo-tagline{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;color:var(--white);margin-top:8px}
.logo-sub{font-size:13px;color:var(--muted);font-style:italic;margin-top:4px}
.big-claim{font-family:'Syne',sans-serif;font-size:26px;font-weight:700;color:var(--white);line-height:1.25;margin-bottom:14px;letter-spacing:-0.5px}
.big-claim em{color:var(--teal);font-style:normal}
.claim-body{font-size:15px;color:var(--muted);line-height:1.65;max-width:580px;margin-bottom:22px}
.founders-row{display:flex;gap:28px;align-items:center;padding-top:18px;border-top:1px solid var(--border)}
.founder-name{font-size:13px;font-weight:600;color:var(--off)}
.founder-title{font-size:12px;color:var(--muted)}
.affil-badge{margin-left:auto;display:flex;gap:10px}
.affil-pill{font-size:11px;font-weight:500;color:var(--teal);border:1px solid var(--teal-dk);padding:4px 12px}

.stats-bar{display:grid;grid-template-columns:repeat(4,1fr);background:var(--card);border:1px solid var(--border);margin-bottom:56px}
.stat{padding:28px 24px;border-right:1px solid var(--border);text-align:center}.stat:last-child{border-right:none}
.stat-num{font-family:'Syne',sans-serif;font-size:42px;font-weight:800;color:var(--gold);line-height:1;margin-bottom:8px}
.stat-label{font-size:12px;color:var(--muted);line-height:1.5;text-transform:uppercase;letter-spacing:.5px}

.section{margin-bottom:56px}
.sec-label{font-size:10.5px;font-weight:600;color:var(--teal);letter-spacing:3px;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:10px}
.sec-label::after{content:'';flex:1;height:1px;background:var(--border)}
.sec-head{font-family:'Syne',sans-serif;font-size:26px;font-weight:700;color:var(--white);line-height:1.2;margin-bottom:12px;letter-spacing:-0.4px}
.sec-body{font-size:14px;color:var(--muted);line-height:1.7;max-width:840px;margin-bottom:24px}

.divider{height:1px;background:var(--border);margin:56px 0;position:relative}
.divider::after{content:'· · ·';position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:var(--dark);padding:0 14px;color:var(--dim);font-size:13px;letter-spacing:4px}

/* SECTION VISUALS — large, full-width or bold half-width */
.visual-full{width:100%;border-radius:12px;overflow:hidden;border:1px solid var(--border);box-shadow:0 12px 48px rgba(0,0,0,.5);margin-bottom:8px}
.visual-full img{width:100%;height:auto;display:block}
.visual-caption{font-size:11px;color:var(--dim);text-align:center;letter-spacing:.5px;margin-bottom:24px;text-transform:uppercase}

/* SVG VISUAL PANELS */
.svg-panel{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:24px}
.svg-panel svg{display:block;width:100%}

/* OCEAN */
.ocean-layout{display:grid;grid-template-columns:1fr 220px 1fr;gap:0 28px;align-items:start}
.comp-group-label{font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.comp-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:18px}
.comp-chip{background:var(--card);border:1px solid var(--border);padding:8px 12px;border-left:3px solid var(--dim)}
.comp-chip.teal{border-left-color:var(--teal-dk)}.comp-chip.gold{border-left-color:var(--gold)}.comp-chip.coral{border-left-color:var(--coral)}.comp-chip.purple{border-left-color:var(--purple)}
.comp-chip .cn{font-size:12px;font-weight:600;color:var(--white)}.comp-chip .cs{font-size:11px;color:var(--muted)}
.biss-orb-wrap{display:flex;flex-direction:column;align-items:center;gap:16px;padding-top:16px}
.biss-orb{width:180px;height:180px;border-radius:50%;background:var(--teal);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;flex-shrink:0}
.biss-orb::before{content:'';position:absolute;inset:-10px;border-radius:50%;border:1px solid var(--teal-dk)}
.biss-orb::after{content:'';position:absolute;inset:-20px;border-radius:50%;border:1px solid var(--border)}
.biss-orb .bw{font-family:'Syne',sans-serif;font-size:36px;font-weight:800;color:var(--dark);line-height:1}
.biss-orb .bs{font-size:8.5px;font-weight:700;color:var(--dark);opacity:.65;text-align:center;margin-top:3px;line-height:1.4}
.orb-caption{font-size:11.5px;color:var(--muted);text-align:center;line-height:1.55;padding:0 8px}

/* MARKETS */
.three-col{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{background:var(--card);border:1px solid var(--border);padding:24px;position:relative;overflow:hidden}
.card-num{font-family:'Syne',sans-serif;font-size:52px;font-weight:800;opacity:.15;position:absolute;top:8px;right:12px;line-height:1}
.card-label{font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}
.card-title{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;color:var(--white);margin-bottom:12px;line-height:1.2}
.card-body{font-size:13px;color:var(--muted);line-height:1.65}
.card-tag{display:inline-block;font-size:10px;font-weight:600;padding:3px 10px;margin-top:14px;border:1px solid}

/* HOW TABLE */
.how-table{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--border)}
.how-head{padding:13px 18px;font-size:10.5px;font-weight:600;letter-spacing:2px;text-transform:uppercase}
.how-head.left{background:var(--card2);color:var(--muted);border-right:1px solid var(--border)}
.how-head.right{background:var(--teal-dk);color:var(--white)}
.how-cell{padding:10px 18px;font-size:13px;border-top:1px solid var(--border);line-height:1.5}
.how-cell.left{background:#08131F;color:var(--muted);border-right:1px solid var(--border)}
.how-cell.right{background:#031F18;color:var(--off)}

/* JOURNEY */
.journey{display:grid;grid-template-columns:repeat(6,1fr);gap:0;border:1px solid var(--border)}
.journey-step{padding:18px 12px;border-right:1px solid var(--border);text-align:center}.journey-step:last-child{border-right:none}
.j-num{width:30px;height:30px;border-radius:50%;background:var(--teal-dk);color:var(--teal2);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0 auto 9px;font-family:'Syne',sans-serif}
.j-title{font-size:11.5px;font-weight:600;color:var(--white);margin-bottom:5px;line-height:1.3}
.j-body{font-size:10.5px;color:var(--muted);line-height:1.5}

/* FLYWHEEL */
.flywheel{background:var(--card);border:1px solid var(--border);border-top:3px solid var(--gold);padding:28px 32px}
.fw-title{font-size:10px;font-weight:600;color:var(--gold);letter-spacing:2.5px;text-transform:uppercase;margin-bottom:6px}
.fw-subtitle{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;color:var(--white);margin-bottom:22px}
.fw-steps{display:flex;align-items:flex-start}
.fw-step{display:flex;flex-direction:column;align-items:center;gap:9px;flex:1;text-align:center}
.fw-num{width:34px;height:34px;border-radius:50%;background:var(--gold);color:var(--dark);font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.fw-text{font-size:11.5px;color:var(--off);line-height:1.5}
.fw-conn{font-size:18px;color:var(--dim);padding:0 4px;margin-top:8px;flex-shrink:0}

/* CONTEST */
.poll-table{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--border)}
.poll-head{padding:11px 16px;font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase}
.poll-head.left{background:#1A2A3A;color:var(--muted);border-right:1px solid var(--border)}
.poll-head.right{background:var(--teal-dk);color:var(--white)}
.poll-cell{padding:9px 16px;font-size:12.5px;border-top:1px solid var(--border)}
.poll-cell.left{background:#08101A;color:var(--muted);border-right:1px solid var(--border)}
.poll-cell.right{background:#021510;color:var(--off)}
.contest-row{display:grid;grid-template-columns:200px 1fr;border:1px solid var(--border);margin-bottom:8px}
.contest-left{padding:14px 16px;background:var(--card2)}
.contest-right{padding:14px 16px;background:var(--card)}

/* PRINCIPLES */
.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--border)}
.principle{padding:22px 18px;border-right:1px solid var(--border);background:var(--card)}.principle:last-child{border-right:none}
.principle-title{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;color:var(--white);margin-bottom:8px}
.principle-body{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:10px}
.badge{display:inline-block;font-size:9px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--teal);border:1px solid var(--teal-dk);padding:3px 8px}

/* REVENUE */
.tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--border);margin-bottom:14px}
.tier{padding:26px 22px;border-right:1px solid var(--border)}.tier:last-child{border-right:none}.tier.premier{background:#0A1E35}
.tier-label{font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;margin-bottom:4px}
.tier.basic .tier-label{color:var(--muted)}.tier.premier .tier-label{color:var(--teal)}.tier.enterprise .tier-label{color:var(--gold)}
.tier-price{font-family:'Syne',sans-serif;font-size:32px;font-weight:800;color:var(--white);line-height:1;margin-bottom:4px}
.tier-price span{font-size:14px;color:var(--muted);font-weight:400;font-family:'Inter',sans-serif}
.tier-sub{font-size:12px;color:var(--muted);margin-bottom:18px}
.tier-features{list-style:none;margin-bottom:18px}
.tier-features li{font-size:12.5px;color:var(--off);padding:5px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:7px;line-height:1.4}
.tier-features li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--teal);flex-shrink:0}
.tier-econ{font-size:12px;color:var(--muted);line-height:1.8}
.tier-econ strong{color:var(--teal2)}
.arr-bar{display:grid;grid-template-columns:repeat(5,1fr);background:var(--navy);border:1px solid var(--border)}
.arr-step{padding:18px 14px;border-right:1px solid var(--border);text-align:center}.arr-step:last-child{border-right:none}
.arr-label{font-size:10px;color:var(--dim);margin-bottom:7px;text-transform:uppercase;letter-spacing:.5px}
.arr-num{font-family:'Syne',sans-serif;font-size:20px;font-weight:800;color:var(--teal);line-height:1;margin-bottom:5px}
.arr-step:last-child .arr-num{color:var(--gold)}
.arr-tag{font-size:10.5px;color:var(--muted)}
.rev-streams{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.rev-card{background:var(--card);border:1px solid var(--border);padding:18px 15px}
.rev-card-label{font-size:9.5px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:5px;color:var(--muted)}
.rev-card-title{font-size:13px;font-weight:600;color:var(--white);margin-bottom:6px;line-height:1.3}
.rev-card-body{font-size:11.5px;color:var(--muted);line-height:1.55}

/* MOATS */
.moats{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--border)}
.moat{padding:22px 20px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
.moat:nth-child(3n){border-right:none}.moat:nth-child(n+4){border-bottom:none}
.moat-num{font-family:'Syne',sans-serif;font-size:34px;font-weight:800;color:var(--teal);opacity:.2;line-height:1;margin-bottom:5px}
.moat-title{font-size:13.5px;font-weight:600;color:var(--teal2);margin-bottom:7px}
.moat-body{font-size:12px;color:var(--muted);line-height:1.6}

/* LAUNCH */
.launch-table{width:100%;border-collapse:collapse;border:1px solid var(--border);font-size:13px}
.launch-table th{background:var(--navy);color:var(--teal);font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;padding:11px 16px;text-align:left;border-bottom:1px solid var(--border);border-right:1px solid var(--border)}
.launch-table th:last-child{border-right:none}
.launch-table td{padding:10px 16px;border-bottom:1px solid var(--border);border-right:1px solid var(--border);color:var(--off);line-height:1.5;vertical-align:top}
.launch-table td:last-child{border-right:none}.launch-table tr:last-child td{border-bottom:none}
.launch-table tr:nth-child(even) td{background:#07101C}
.launch-table td:first-child{font-weight:600;color:var(--teal2)}.launch-table td:last-child{color:var(--gold);font-weight:600}

/* PARTNERS */
.partners{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.partner-card{background:var(--card);border:1px solid var(--border);padding:14px 13px}
.partner-phase{font-size:9.5px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--teal);margin-bottom:5px}
.partner-name{font-size:13px;font-weight:600;color:var(--white);margin-bottom:5px}
.partner-body{font-size:11px;color:var(--muted);line-height:1.5}

/* ── WIREFRAME SHOWCASE ── */
.wf-section{margin-bottom:72px}
.wf-screen{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:48px}
.wf-header{padding:20px 28px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:baseline}
.wf-title{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;color:var(--white)}
.wf-num{font-family:'Syne',sans-serif;font-size:13px;color:var(--teal);font-weight:700;letter-spacing:1px}
.wf-desc{padding:14px 28px 20px;font-size:13px;color:var(--muted);line-height:1.6;border-bottom:1px solid var(--border)}
.wf-body{padding:32px 28px}

/* Phone frame */
.phone-outer{display:flex;justify-content:center;padding:8px 0}
.phone-frame{width:320px;background:#0d1117;border-radius:40px;border:2px solid #2a2a3a;overflow:hidden;box-shadow:0 0 0 1px #1a1a2e,0 24px 64px rgba(0,0,0,.6)}
.phone-notch{width:100px;height:24px;background:#0d1117;border-radius:0 0 16px 16px;margin:0 auto;position:relative;z-index:2}
.phone-status{display:flex;justify-content:space-between;align-items:center;padding:10px 20px 4px;font-size:11px;color:#555}
.phone-nav{display:flex;align-items:center;justify-content:space-between;padding:8px 16px;border-bottom:.5px solid #1e2030}
.phone-screen{background:#0d1117;min-height:540px}
.phone-tab-bar{display:flex;justify-content:space-around;align-items:center;padding:10px 0 16px;border-top:.5px solid #1e2030;background:#0d1117}
.phone-tab{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:9px;color:#444}
.phone-tab.active{color:var(--pink)}

/* Desktop frame */
.desktop-frame{background:#0a0f1a;border:1.5px solid #1a2a3a;border-radius:12px;overflow:hidden;box-shadow:0 16px 56px rgba(0,0,0,.6)}
.desktop-bar{background:#040810;padding:10px 16px;display:flex;align-items:center;gap:8px;border-bottom:1px solid #0d1a2e}
.desktop-dots{display:flex;gap:6px}
.desktop-dot{width:12px;height:12px;border-radius:50%}
.url-bar{flex:1;background:#0d1a2e;border-radius:6px;padding:5px 12px;font-size:11px;color:#3a5070;font-family:monospace;margin:0 12px;max-width:300px}

/* Sentiment bar */
.sent-bar-wrap{margin:6px 0}
.sent-bar-track{height:6px;background:#1a2540;border-radius:3px;overflow:hidden}
.sent-bar-fill{height:100%;border-radius:3px}

/* Chat bubble */
.chat-ai{background:#1a2540;border-radius:16px 16px 16px 4px;padding:10px 14px;font-size:12.5px;color:#c8d8ee;margin-bottom:8px;max-width:85%;line-height:1.5}
.chat-user{background:#00C4A7;border-radius:16px 16px 4px 16px;padding:10px 14px;font-size:12.5px;color:#0a1628;margin-bottom:8px;max-width:85%;margin-left:auto;line-height:1.5}
.chat-pill{display:inline-flex;align-items:center;gap:6px;background:#0F2442;border:1px solid var(--teal-dk);border-radius:20px;padding:4px 10px;font-size:11px;color:var(--teal2);margin-top:4px}

/* Story card */
.story-card{background:#0d1830;border:1px solid #1a3050;border-radius:12px;overflow:hidden;margin-bottom:10px}
.story-header{padding:12px 14px 8px;display:flex;justify-content:space-between;align-items:flex-start}
.story-score{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;color:var(--gold)}
.story-score.neg{color:#F97066}
.story-body-text{padding:0 14px;font-size:12px;color:#8a9abc;line-height:1.6;margin-bottom:10px}
.story-footer{padding:8px 14px;border-top:1px solid #1a3050;display:flex;justify-content:space-between;align-items:center}
.one-word-pills{display:flex;gap:6px}
.owp{background:#1a2540;border:1px solid #2a3a55;border-radius:20px;padding:3px 9px;font-size:11px;color:#647a96}

/* Dashboard mini */
.dash-metric{background:#0d1830;border:1px solid #1a3050;border-radius:8px;padding:12px 14px;text-align:center}
.dash-num{font-family:'Syne',sans-serif;font-size:26px;font-weight:800;color:var(--teal2);line-height:1}
.dash-num.gold{color:var(--gold)}
.dash-label{font-size:10px;color:#3a5070;text-transform:uppercase;letter-spacing:1px;margin-top:3px}
.dash-chart{height:60px;background:#0a1220;border-radius:6px;overflow:hidden;position:relative}
.dash-line{position:absolute;bottom:0;left:0;right:0;height:100%}

/* Pain point bar */
.pain-item{margin-bottom:8px}
.pain-label{font-size:11px;color:#8a9abc;margin-bottom:3px;display:flex;justify-content:space-between}
.pain-track{height:5px;background:#0a1220;border-radius:3px;overflow:hidden}
.pain-fill{height:100%;background:var(--gold);border-radius:3px}

/* Discover feed */
.feed-item{background:#0d1830;border-radius:10px;padding:12px 14px;margin-bottom:8px}
.feed-user{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.feed-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--dark)}
.feed-score-badge{font-family:'Syne',sans-serif;font-size:16px;font-weight:800;border-radius:8px;padding:4px 9px}

/* Contest */
.contest-prompt{background:#0f1a00;border:1px solid var(--gold);border-radius:12px;padding:16px 18px;margin-bottom:14px}
.contest-entry{background:#0d1830;border:1px solid #1a3050;border-radius:8px;padding:10px 12px;margin-bottom:6px}
.contest-vote-bar{display:flex;gap:3px;margin-top:8px}
.contest-vote{border-radius:20px;padding:3px 9px;font-size:11px;border:1px solid;cursor:pointer}

/* Parallel universe */
.pu-compare{display:grid;grid-template-columns:1fr 40px 1fr;gap:0;align-items:stretch}
.pu-card{background:#0d1830;border:1px solid #1a3050;border-radius:10px;padding:14px}
.pu-vs{display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#3a5070}

footer{margin-top:56px;border-top:1px solid var(--border);padding-top:22px;display:flex;justify-content:space-between;align-items:center}
.footer-tagline{font-family:'Syne',sans-serif;font-size:26px;font-weight:700;color:var(--teal);letter-spacing:-.5px}
.footer-sub{font-size:11px;color:var(--dim);margin-top:4px}
.footer-right{text-align:right;font-size:12px;color:var(--muted);line-height:1.8}
.footer-right strong{color:var(--off)}

/* annotations */
.ann{position:relative;display:inline-flex;align-items:center;gap:6px;background:var(--navy);border:1px solid var(--border);border-radius:20px;padding:4px 10px;font-size:11px;color:var(--muted);margin:2px}
.ann-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
</style>
</head>
<body>
<div class="page">

<!-- ══ MASTHEAD ═══════════════════════════════════════════════ -->
<div class="masthead">
  <div>
    <div class="logo">BISS</div>
    <div class="logo-tagline">Conversational Customer Intelligence</div>
    <div class="logo-sub">Because I Said So &nbsp;·&nbsp; Tell Your Truth.</div>
  </div>
  <div>
    <div class="big-claim">If Reddit, Yelp, Meltwater, Instagram,<br>Rotten Tomatoes, and a therapist had a baby —<br><em>that baby is BISS.</em></div>
    <div class="claim-body">The category is called Conversational Customer Intelligence. BISS invented it. Zero direct competitors. Authentic emotional truth — generated through therapeutic AI conversation — becomes the most proprietary business intelligence dataset in the world. The first-mover window is 18–24 months.</div>
    <div class="founders-row">
      <div><div class="founder-name">Marc Sternberg</div><div class="founder-title">Co-Founder &amp; CEO</div></div>
      <div><div class="founder-name">Simge Helvaci</div><div class="founder-title">Co-Founder &amp; CTO</div></div>
      <div class="affil-badge">
        <div class="affil-pill">Oxford Saïd</div>
        <div class="affil-pill">NVIDIA Inception</div>
        <div class="affil-pill">Confidential</div>
      </div>
    </div>
  </div>
</div>

<!-- ══ STATS ══════════════════════════════════════════════════ -->
<div class="stats-bar">
  <div class="stat"><div class="stat-num">30%+</div><div class="stat-label">of online reviews are<br>fake or manipulated</div></div>
  <div class="stat"><div class="stat-num">$30K+</div><div class="stat-label">cheapest enterprise<br>intelligence tool per year</div></div>
  <div class="stat"><div class="stat-num">3–5%</div><div class="stat-label">average survey<br>response rate</div></div>
  <div class="stat"><div class="stat-num">28M</div><div class="stat-label">US SMBs locked out of<br>real customer intelligence</div></div>
</div>

<!-- ══ BLUE OCEAN ══════════════════════════════════════════════ -->
<div class="section">
  <div class="sec-label">The Blue Ocean — Category Creation</div>
  <div class="sec-head">Every platform below does one thing well.<br>BISS does all of it — and generates original private intelligence none of them can touch.</div>
  <div class="sec-body">BISS is not a review site. Not a social platform. Not a survey tool. Not a social listening product. It is the intersection of all of them — a dual-sided marketplace that creates an entirely new product category with zero direct competitors.</div>

  <div class="ocean-layout">
    <div>
      <div class="comp-group-label" style="color:var(--teal)">Social &amp; Community</div>
      <div class="comp-grid">
        <div class="comp-chip teal"><div class="cn">Reddit</div><div class="cs">community &amp; voting</div></div>
        <div class="comp-chip teal"><div class="cn">Instagram</div><div class="cs">social &amp; polls</div></div>
        <div class="comp-chip teal"><div class="cn">Twitter / X</div><div class="cs">public conversation</div></div>
        <div class="comp-chip teal"><div class="cn">TikTok</div><div class="cs">video social</div></div>
        <div class="comp-chip teal"><div class="cn">Facebook</div><div class="cs">social network</div></div>
        <div class="comp-chip teal"><div class="cn">Wattpad</div><div class="cs">creative writing</div></div>
      </div>
      <div class="comp-group-label" style="color:var(--gold)">Review &amp; Ratings Platforms</div>
      <div class="comp-grid">
        <div class="comp-chip gold"><div class="cn">Yelp</div><div class="cs">gamed local reviews</div></div>
        <div class="comp-chip gold"><div class="cn">Google Reviews</div><div class="cs">star ratings</div></div>
        <div class="comp-chip gold"><div class="cn">Rotten Tomatoes</div><div class="cs">crowd ratings</div></div>
        <div class="comp-chip gold"><div class="cn">TripAdvisor</div><div class="cs">travel reviews</div></div>
        <div class="comp-chip gold"><div class="cn">Trustpilot</div><div class="cs">brand reviews</div></div>
        <div class="comp-chip gold"><div class="cn">Glassdoor</div><div class="cs">employer reviews</div></div>
      </div>
    </div>
    <div class="biss-orb-wrap">
      <div class="biss-orb">
        <div class="bw">BISS</div>
        <div class="bs">CONVERSATIONAL<br>CUSTOMER<br>INTELLIGENCE</div>
      </div>
      <div class="orb-caption">The only platform that generates original private intelligence through therapeutic AI — and monetizes it three different ways simultaneously.</div>
    </div>
    <div>
      <div class="comp-group-label" style="color:var(--coral)">Enterprise Intelligence</div>
      <div class="comp-grid">
        <div class="comp-chip coral"><div class="cn">Meltwater</div><div class="cs">social listening · $30K+</div></div>
        <div class="comp-chip coral"><div class="cn">Brandwatch</div><div class="cs">social listening</div></div>
        <div class="comp-chip coral"><div class="cn">Qualtrics</div><div class="cs">surveys &amp; CX · $15K+</div></div>
        <div class="comp-chip coral"><div class="cn">SurveyMonkey</div><div class="cs">survey tools</div></div>
        <div class="comp-chip coral"><div class="cn">Medallia</div><div class="cs">enterprise CX · $50K+</div></div>
        <div class="comp-chip coral"><div class="cn">Sprout Social</div><div class="cs">social management</div></div>
      </div>
      <div class="comp-group-label" style="color:var(--purple)">Content &amp; Niche Communities</div>
      <div class="comp-grid">
        <div class="comp-chip purple"><div class="cn">Letterboxd</div><div class="cs">film community</div></div>
        <div class="comp-chip purple"><div class="cn">Goodreads</div><div class="cs">book community</div></div>
        <div class="comp-chip purple"><div class="cn">Amazon Reviews</div><div class="cs">commerce reviews</div></div>
        <div class="comp-chip purple"><div class="cn">Bazaarvoice</div><div class="cs">commerce intelligence</div></div>
        <div class="comp-chip purple"><div class="cn">Day One</div><div class="cs">personal journaling</div></div>
        <div class="comp-chip purple"><div class="cn">Yelp / G2</div><div class="cs">niche platforms</div></div>
      </div>
    </div>
  </div>
</div>

<!-- ══ THREE MARKETS ══════════════════════════════════════════ -->
<div class="section">
  <div class="sec-label">The Platform — One Content Engine, Three Markets</div>
  <div class="sec-head">BISS is a content generation platform at its core.</div>
  <div class="sec-body">Users share authentic experiences through therapeutic AI conversation. That content simultaneously powers three distinct markets with three distinct revenue streams.</div>
  <div class="three-col">
    <div class="card"><div style="position:absolute;top:0;left:0;width:100%;height:3px;background:var(--teal)"></div><div class="card-num" style="color:var(--teal)">01</div><div class="card-label" style="color:var(--teal)">Intelligence Market</div><div class="card-title">The B2B Intelligence Engine</div><div class="card-body">Businesses pay for intelligence extracted from authentic user content — sentiment trends, emotional journey mapping, early issue detection, competitive benchmarking. What Meltwater charges $30K/year for, BISS delivers at $50–$800/month.</div><div class="card-tag" style="color:var(--teal);border-color:var(--teal-dk)">Primary Revenue · 90–95% of B2B</div></div>
    <div class="card"><div style="position:absolute;top:0;left:0;width:100%;height:3px;background:var(--purple)"></div><div class="card-num" style="color:var(--purple)">02</div><div class="card-label" style="color:var(--purple)">Community Market</div><div class="card-title">The Word-of-Mouth Engine</div><div class="card-body">Experiences from people you already follow surface first — friends, colleagues, creators you trust. The most powerful trusted word-of-mouth engine ever built, available the moment a decision needs to be made. Drives network effects and retention.</div><div class="card-tag" style="color:var(--purple);border-color:#4A4E8A">Consumer Retention · Network Effects</div></div>
    <div class="card" style="background:#0A0E00"><div style="position:absolute;top:0;left:0;width:100%;height:3px;background:var(--gold)"></div><div class="card-num" style="color:var(--gold)">03</div><div class="card-label" style="color:var(--gold)">Creative Market</div><div class="card-title">The Audience Acquisition Engine</div><div class="card-body">Any brand or public figure can seed a creative challenge — and receive 50,000 stories, not poll clicks. McDonald's next tagline. Taylor Swift's next album title. The contest platform is simultaneously a revenue stream and BISS's most powerful user acquisition mechanism.</div><div class="card-tag" style="color:var(--gold);border-color:#7A5A10">Contest Platform · Acquisition Engine</div></div>
  </div>
</div>

<!-- ══ HOW IT WORKS ════════════════════════════════════════════ -->
<div class="section">
  <div class="sec-label">How It Works</div>
  <div class="sec-head">One conversation. Multiple journal entries. Real intelligence.</div>
  <div class="sec-body">When a user opens BISS, an empathetic AI asks a single open-ended question. Not a form. Not a survey. A single airport nightmare mentioning Delta, Marriott, and Chick-fil-A automatically becomes three polished journal entries — three businesses receive intelligence simultaneously from one conversation.</div>
  <div class="how-table">
    <div class="how-head left">For Users — What They Experience</div>
    <div class="how-head right">For Businesses — What They Receive</div>
    <div class="how-cell left">Therapeutic AI conversation — not a form, not a survey, not a star rating</div><div class="how-cell right">Real-time sentiment trends and emotional journey mapping</div>
    <div class="how-cell left">Real-Time Emotional Face mirrors emotional state as they type</div><div class="how-cell right">Early issue detection before problems go viral on social media</div>
    <div class="how-cell left">AI infers ratings from the full narrative — no star ratings, ever</div><div class="how-cell right">Competitive benchmarking within vertical against named rivals</div>
    <div class="how-cell left">One conversation auto-splits into multiple brand journal entries</div><div class="how-cell right">AI-generated actionable recommendations from authentic stories</div>
    <div class="how-cell left">Pseudonymous — real identity verified, never publicly exposed</div><div class="how-cell right">Seed targeted questions into user conversation flow</div>
    <div class="how-cell left">Gamification: Story Coins, XP, AR hunts, leaderboards, badges</div><div class="how-cell right">Contest &amp; engagement platform drives massive audience acquisition</div>
  </div>
</div>

<!-- ══ 6-STAGE JOURNEY ════════════════════════════════════════ -->
<div class="section">
  <div class="sec-label">The 6-Stage User Journey</div>
  <div class="journey">
    <div class="journey-step"><div class="j-num">1</div><div class="j-title">Account &amp; Onboarding</div><div class="j-body">Create pseudonymous profile · Set privacy preferences · Verified, never exposed</div></div>
    <div class="journey-step"><div class="j-num">2</div><div class="j-title">AI Chat + Emotional Face</div><div class="j-body">Tell your story · Real-time face mirrors state · Feels like talking to a friend</div></div>
    <div class="journey-step"><div class="j-num">3</div><div class="j-title">Journal Entry Created</div><div class="j-body">AI writes, scores &amp; splits · Privacy controls · Published instantly</div></div>
    <div class="journey-step"><div class="j-num">4</div><div class="j-title">Brand Pages</div><div class="j-body">Story feeds brand profile · B2B dashboard updates in real time</div></div>
    <div class="journey-step"><div class="j-num">5</div><div class="j-title">Explore &amp; Discover</div><div class="j-body">Trusted community feed · One-word responses · Parallel Universe</div></div>
    <div class="journey-step"><div class="j-num">6</div><div class="j-title">Rewards &amp; Profile</div><div class="j-body">XP · Coins · Badges · Leaderboards · AR treasure hunts</div></div>
  </div>
</div>

<!-- ══ CUSTOMER JOURNEY MAP — full PDF image ══════════════════ -->
<div class="section">
  <div class="visual-full"><img src="data:image/jpeg;base64," alt="BISS Customer Journey Map"></div>
  <div class="visual-caption">Customer Journey Map — From First Story to Brand Intelligence · The Complete Flow</div>
</div>

<div class="divider"></div>

<!-- ══ CONTEST PLATFORM ════════════════════════════════════════ -->
<div class="section">
  <div class="sec-label">The Contest &amp; Engagement Platform — Core Feature · Key Differentiator · Major Revenue Stream</div>
  <div class="sec-head">Instagram gives you a number. BISS gives you 50,000 stories.</div>
  <div class="sec-body">The contest platform is not a bolt-on feature. It is a third fully independent business model running on the same infrastructure — serving a completely different customer need and functioning as BISS's most powerful consumer acquisition mechanism. A monetization engine, an acquisition engine, and a category differentiator simultaneously.</div>

  <div class="poll-table" style="margin-bottom:28px">
    <div class="poll-head left">A Poll (Instagram / Twitter)</div>
    <div class="poll-head right">A BISS Seeded Question or Contest</div>
    <div class="poll-cell left">Returns a number</div><div class="poll-cell right">Returns stories with emotional context</div>
    <div class="poll-cell left">One tap, zero effort from users</div><div class="poll-cell right">Users write — invested, authentic responses</div>
    <div class="poll-cell left">No insight into the why</div><div class="poll-cell right">Full narrative explaining the reasoning</div>
    <div class="poll-cell left">Forgotten in 24 hours</div><div class="poll-cell right">Permanent, searchable, indexed content forever</div>
    <div class="poll-cell left">No B2B intelligence value</div><div class="poll-cell right">Feeds B2B dashboard as proprietary intelligence</div>
    <div class="poll-cell left">Cannot generate creative output</div><div class="poll-cell right" style="color:var(--teal2);font-weight:500">McDonald's next tagline. Taylor Swift's next album title.</div>
  </div>

  <div style="font-size:10.5px;font-weight:600;color:var(--gold);letter-spacing:2px;text-transform:uppercase;margin-bottom:14px">Three Types of Contest Creators</div>
  <div class="contest-row"><div class="contest-left" style="border-left:3px solid var(--teal)"><div style="font-size:12.5px;font-weight:600;color:var(--white)">Brand / Business</div></div><div class="contest-right"><div style="font-size:13px;color:var(--muted)">McDonald's: Submit our next jingle. Norwegian Cruise: Tell us your best cruise memory. Nike: Design our next slogan. <strong style="color:var(--off)">Gets:</strong> Creative output from their real audience, market research, authentic UGC, brand engagement metrics, and proprietary intelligence data.</div></div></div>
  <div class="contest-row"><div class="contest-left" style="border-left:3px solid var(--gold)"><div style="font-size:12.5px;font-weight:600;color:var(--white)">Public Figure / Creator</div></div><div class="contest-right"><div style="font-size:13px;color:var(--muted)">Taylor Swift: Which dress for my wedding? A film director: Which ending should I use? An athlete: Name our new mascot. <strong style="color:var(--off)">Gets:</strong> Genuine fan connection with emotional depth far beyond social polls. A permanent, searchable cultural moment. Responses they can actually read and act on.</div></div></div>
  <div class="contest-row" style="margin-bottom:28px"><div class="contest-left" style="border-left:3px solid var(--purple)"><div style="font-size:12.5px;font-weight:600;color:var(--white)">Community / BISS-Seeded</div></div><div class="contest-right"><div style="font-size:13px;color:var(--muted)">BISS weekly: Best travel experience of the month. Most underrated restaurant in your city. BISS seeds its own contests to fill content gaps, drive daily activity, and build community at zero additional acquisition cost.</div></div></div>

  <div class="flywheel" style="margin-bottom:28px">
    <div class="fw-title">The Celebrity Flywheel</div>
    <div class="fw-subtitle">Public figures are simultaneously a customer and BISS's most powerful acquisition channel. No competitor has built this.</div>
    <div class="fw-steps">
      <div class="fw-step"><div class="fw-num">1</div><div class="fw-text">Public figure seeds a question or creative challenge to the BISS audience</div></div>
      <div class="fw-conn">→</div>
      <div class="fw-step"><div class="fw-num">2</div><div class="fw-text">Their existing audience arrives at BISS — creating new accounts in the process</div></div>
      <div class="fw-conn">→</div>
      <div class="fw-step"><div class="fw-num">3</div><div class="fw-text">Users write stories, not clicks — emotionally rich, permanent responses</div></div>
      <div class="fw-conn">→</div>
      <div class="fw-step"><div class="fw-num">4</div><div class="fw-text">New users discover journals, brand contests, and the community</div></div>
      <div class="fw-conn">→</div>
      <div class="fw-step"><div class="fw-num">5</div><div class="fw-text">The moment is permanent — other creators notice the depth and want in</div></div>
    </div>
  </div>

  <div style="background:var(--card);border:1px solid var(--border);border-left:3px solid var(--teal);padding:16px 20px">
    <div style="font-size:10px;font-weight:600;color:var(--teal);letter-spacing:2px;text-transform:uppercase;margin-bottom:6px">The Legal Position — BISS Is the Stadium</div>
    <div style="font-size:13px;color:var(--muted);line-height:1.65">BISS does not own, judge, or take any position on contest content. The creator sets their own terms. Participants agree directly. BISS provides the room — nothing more. BISS never takes a percentage of prize money, never owns or licenses contest submissions, never selects winners. Section 230 protections apply via the same documented moderation system as journal entries.</div>
  </div>
</div>

<!-- ══ PLATFORM PRINCIPLES ════════════════════════════════════ -->
<div class="section">
  <div class="sec-label">Platform Principles — The Architecture of Trust</div>
  <div class="principles">
    <div class="principle"><div class="principle-title">No Advertising</div><div class="principle-body">Users are never the product sold to advertisers. Funded entirely by businesses paying for intelligence, not by selling user attention.</div><div class="badge">Non-Negotiable</div></div>
    <div class="principle"><div class="principle-title">95% Always Free</div><div class="principle-body">Freemium is permanent, not a phase. The B2B value proposition depends on a large, authentic user base generating stories.</div><div class="badge">Non-Negotiable</div></div>
    <div class="principle"><div class="principle-title">AI-Inferred Ratings</div><div class="principle-body">No star ratings — ever. AI reads the full narrative and infers sentiment. Eliminates the core pathology of every existing review platform: gaming.</div><div class="badge">Non-Negotiable</div></div>
    <div class="principle"><div class="principle-title">Always Anonymous</div><div class="principle-body">Real identity verified at account creation. Never publicly exposed. Verified but pseudonymous — what makes honest sharing possible at scale.</div><div class="badge">Non-Negotiable</div></div>
  </div>
</div>

<div class="divider"></div>

<!-- ══ REVENUE MODEL ═══════════════════════════════════════════ -->
<div class="section">
  <div class="sec-label">Revenue Model — 78–83% Gross Margin · Conservative Projections · Verified Unit Economics</div>
  <div class="sec-head">The dual-sided flywheel: 95% of users are free.<br>Their authentic stories are the product businesses pay for.</div>
  <div class="tiers" style="margin-top:24px">
    <div class="tier basic"><div class="tier-label">Basic</div><div class="tier-price">$50<span>/mo</span></div><div class="tier-sub">~20% of customers · micro businesses</div><ul class="tier-features"><li>1 dashboard seat</li><li>1 monthly sentiment report</li><li>Basic Brand Page</li><li>Email support</li></ul><div class="tier-econ">LTV <strong>$4,500</strong> · CAC $1,500–$2,500 · Ratio <strong>2–3×</strong></div></div>
    <div class="tier premier"><div class="tier-label">★ Premier</div><div class="tier-price">$150–250<span>/mo</span></div><div class="tier-sub">~60% · primary growth tier</div><ul class="tier-features"><li>3 seats · 5 monthly reports</li><li>Seed Question campaigns</li><li>Competitive intelligence</li><li>Creator introductions</li></ul><div class="tier-econ">LTV <strong>$9,000</strong> · CAC $2,000–$3,500 · Ratio <strong>3–4×</strong></div></div>
    <div class="tier enterprise"><div class="tier-label">Enterprise</div><div class="tier-price">$500–800<span>/mo</span></div><div class="tier-sub">~20% · regional chains &amp; larger brands</div><ul class="tier-features"><li>10 seats · unlimited reports</li><li>API + CRM integration</li><li>Dedicated Customer Success</li><li>Custom deep-dive reports</li></ul><div class="tier-econ">LTV <strong>$21,600</strong> · CAC $3,000–$5,000 · Ratio <strong>4–6×</strong></div></div>
  </div>
  <div class="arr-bar" style="margin-bottom:20px">
    <div class="arr-step"><div class="arr-label">Month 18</div><div class="arr-num">$3.5K</div><div class="arr-tag">Proof of concept</div></div>
    <div class="arr-step"><div class="arr-label">Month 30</div><div class="arr-num">$29K</div><div class="arr-tag">Unit economics live</div></div>
    <div class="arr-step"><div class="arr-label">Month 42</div><div class="arr-num">$79K</div><div class="arr-tag">Expanding verticals</div></div>
    <div class="arr-step"><div class="arr-label">Series A</div><div class="arr-num">$150–250K</div><div class="arr-tag">8–12 customers</div></div>
    <div class="arr-step"><div class="arr-label">Year 5</div><div class="arr-num">$8–12M</div><div class="arr-tag">1,000–1,500 customers</div></div>
  </div>
  <div class="rev-streams">
    <div class="rev-card" style="border-top:2px solid var(--teal)"><div class="rev-card-label">Primary 90–95%</div><div class="rev-card-title">B2B Subscriptions</div><div class="rev-card-body">Monthly fees for intelligence dashboards, sentiment reports, emotional journey maps, and competitive brand analysis.</div></div>
    <div class="rev-card" style="border-top:2px solid var(--gold)"><div class="rev-card-label">Contest Platform</div><div class="rev-card-title">Hosting Fees + Creator Subs</div><div class="rev-card-body">Contest creation fees, promoted placement, verified creator accounts, analytics reports. BISS never takes prize money or IP.</div></div>
    <div class="rev-card" style="border-top:2px solid var(--purple)"><div class="rev-card-label">Secondary ~5%</div><div class="rev-card-title">Prompt Seeding Campaigns</div><div class="rev-card-body">Brands inject targeted questions into conversation flow. $100–$5,000/month. Appears organically — not as advertising.</div></div>
    <div class="rev-card" style="border-top:2px solid var(--coral)"><div class="rev-card-label">Year 3+</div><div class="rev-card-title">Data Licensing &amp; API</div><div class="rev-card-body">Anonymized trend data licensed to research firms. $10,000–$50,000/year at scale. Enterprise API integration.</div></div>
  </div>
</div>

<!-- ══ REVENUE MODEL PDF IMAGE — full width ═══════════════════ -->
<div class="section">
  <div class="visual-full"><img src="data:image/jpeg;base64," alt="BISS Revenue Model — Dual-Sided Flywheel"></div>
  <div class="visual-caption">Revenue Model — The Dual-Sided Flywheel · From official BISS Platform Narrative</div>
